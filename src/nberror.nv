// nberror — every refusal, and the one sentence each of them renders
// to.
//
// TWO KINDS OF WRONG, AND THEY ARE NOT THE SAME KIND.  A notebook can
// fail to be JSON at all, and it can be JSON of the wrong shape.  The
// first is fatal: there is no document, and `nbread.read` answers an
// `NbFault`.  The second is not: a notebook whose third cell is missing
// its identifier is still a notebook a tool can show, and refusing to
// open it would be worse than opening it — which is why the shape rules
// are a LIST OF ISSUES from `nbvalidate` rather than an error from the
// reader.  `nbread.read_strict` is for the caller that wants the second
// kind fatal too.
//
// The two are one taxonomy, because a caller that funnels both into one
// log writes one match, and because `nbread.read_strict` turns an issue
// into a fault and needs somewhere to put it.

// What made a notebook unreadable, or what a shape rule objected to.
//
// `path` on the shape faults is the JSON Pointer of the member at
// fault — `"/cells/2/id"` — because a message that named only the rule
// would leave a user of a two-hundred-cell notebook to find it.
pub enum NbFault
    // The text is not JSON.
    NbNotJson(at: Int)
    // The top-level value is not a JSON object.
    NbNotAnObject
    // `nbformat` is missing, or is not an integer.
    NbNoFormatVersion
    // `nbformat` names a major version this package does not read.
    // Only 4 is read; 1, 2 and 3 are different documents and are named
    // in the README as not included.
    NbUnsupportedFormat(major: Int, minor: Int)
    // A required member is absent.  `path` is its JSON Pointer.
    NbMissingMember(path: Str, member: Str)
    // A member is present with a type the format does not allow there.
    NbWrongMemberType(path: Str, want: Str, saw: Str)
    // `cell_type` names something other than `"code"`, `"markdown"` or
    // `"raw"`.
    NbUnknownCellType(path: Str, saw: Str)
    // `output_type` names something other than `"stream"`,
    // `"display_data"`, `"execute_result"` or `"error"`.
    NbUnknownOutputType(path: Str, saw: Str)
    // A cell identifier that breaks the 4.5 rule: one to sixty-four
    // characters from the set of letters, digits, `-` and `_`.
    NbBadCellId(path: Str, saw: Str)
    // Two cells carry the same identifier.  nbformat 4.5 requires them
    // to be unique within a notebook.
    NbDuplicateCellId(path: Str, id: Str)
    // A member the format says a cell of this kind may not have — an
    // `outputs` on a markdown cell, an `execution_count` on a raw one.
    NbForbiddenMember(path: Str, member: Str)
    // A MIME bundle member whose payload is not the shape its MIME type
    // requires: a `text/plain` that is not a multiline string, an
    // `image/png` that is not base64 text.
    NbBadMimePayload(path: Str, mime: Str)
    // An `image/png` or other binary MIME payload whose text is not
    // base64.
    NbBadBase64(path: Str, mime: Str)
    // An attachment name that is empty, or a bundle under it that is
    // not an object.
    NbBadAttachment(path: Str, name: Str)
    // `execution_count` is neither null nor a non-negative integer.
    NbBadExecutionCount(path: Str)
    // A notebook that would be written at a format version whose rules
    // it does not satisfy — a 4.5 notebook whose cells have no
    // identifiers.
    NbNotWritableAt(major: Int, minor: Int, why: Str)

// The standard `Error` implementation, so a bad notebook can be
// reported by anything that reports errors.
//
// The sentence names what is wrong — the member, the MIME type, the
// version, the identifier — and `path_of` names where, so a caller that
// wants both writes the two together, which is exactly what
// `nbvalidate.issue_text` does.
impl Error for NbFault
    // Answer the one-line report: what was wrong, and where in the
    // document.
    fn message(self) -> Str
        match self
            NbNotJson(at)                      => "the text is not JSON"
            NbNotAnObject                      => "the top-level JSON value is not an object"
            NbNoFormatVersion                  => "nbformat is missing, or is not an integer"
            NbUnsupportedFormat(major, minor)  => "nbformat ${major}.${minor} is not a format this package reads; only major version 4 is"
            NbMissingMember(path, member)      => "a required member is missing: ${member}"
            NbWrongMemberType(path, want, saw) => "${saw} where ${want} is required"
            NbUnknownCellType(path, saw)       => "unknown cell_type '${saw}'"
            NbUnknownOutputType(path, saw)     => "unknown output_type '${saw}'"
            NbBadCellId(path, saw)             => "'${saw}' is not a cell identifier: one to sixty-four letters, digits, '-' or '_'"
            NbDuplicateCellId(path, id)        => "the cell identifier '${id}' is used more than once"
            NbForbiddenMember(path, member)    => "a cell of this kind may not carry '${member}'"
            NbBadMimePayload(path, mime)       => "the payload under '${mime}' is not the shape that MIME type requires"
            NbBadBase64(path, mime)            => "the payload under '${mime}' is not base64"
            NbBadAttachment(path, name)        => "not an attachment: '${name}'"
            NbBadExecutionCount(path)          => "an execution count must be null or a non-negative integer"
            NbNotWritableAt(major, minor, why) => "the notebook does not satisfy nbformat ${major}.${minor}: ${why}"

// The JSON Pointer of the member at fault, or `""` for the faults that
// are about the document as a whole.
//
// ```novo
// use nberror
//
// fn main() [io]
//     println(nberror.path_of(NbMissingMember("/cells/2", "id")))   // /cells/2
// ```
pub fn path_of(f: NbFault) -> Str []
    match f
        NbNotJson(at)                   => ""
        NbNotAnObject                   => ""
        NbNoFormatVersion               => ""
        NbUnsupportedFormat(maj, min)   => ""
        NbMissingMember(path, member)   => path
        NbWrongMemberType(path, w, s)   => path
        NbUnknownCellType(path, saw)    => path
        NbUnknownOutputType(path, saw)  => path
        NbBadCellId(path, saw)          => path
        NbDuplicateCellId(path, id)     => path
        NbForbiddenMember(path, member) => path
        NbBadMimePayload(path, mime)    => path
        NbBadBase64(path, mime)         => path
        NbBadAttachment(path, name)     => path
        NbBadExecutionCount(path)       => path
        NbNotWritableAt(maj, min, why)  => ""

// A short, stable name for the fault, for a metric label or a test.
//
// The variant's own spelling with the `Nb` prefix removed and the words
// separated by hyphens: `"not-json"`, `"bad-cell-id"`,
// `"duplicate-cell-id"`.
//
// ```novo
// use nberror
//
// fn main() [io]
//     println(nberror.code_of(NbNotAnObject))   // not-an-object
// ```
pub fn code_of(f: NbFault) -> Str []
    match f
        NbNotJson(at)                   => "not-json"
        NbNotAnObject                   => "not-an-object"
        NbNoFormatVersion               => "no-format-version"
        NbUnsupportedFormat(maj, min)   => "unsupported-format"
        NbMissingMember(path, member)   => "missing-member"
        NbWrongMemberType(path, w, s)   => "wrong-member-type"
        NbUnknownCellType(path, saw)    => "unknown-cell-type"
        NbUnknownOutputType(path, saw)  => "unknown-output-type"
        NbBadCellId(path, saw)          => "bad-cell-id"
        NbDuplicateCellId(path, id)     => "duplicate-cell-id"
        NbForbiddenMember(path, member) => "forbidden-member"
        NbBadMimePayload(path, mime)    => "bad-mime-payload"
        NbBadBase64(path, mime)         => "bad-base64"
        NbBadAttachment(path, name)     => "bad-attachment"
        NbBadExecutionCount(path)       => "bad-execution-count"
        NbNotWritableAt(maj, min, why)  => "not-writable-at"

// Whether the fault stops the notebook being read at all.
//
// True for `NbNotJson`, `NbNotAnObject`, `NbNoFormatVersion` and
// `NbUnsupportedFormat` — the four that mean there is no document.
// False for the shape faults, which `nbread.read` reports as issues on
// a notebook it still hands back.
//
// ```novo
// use nberror
//
// fn main() [io]
//     println("${nberror.is_fatal(NbNotJson(0))}")   // true
// ```
pub fn is_fatal(f: NbFault) -> Bool []
    match f
        NbNotJson(at)                      => true
        NbNotAnObject                      => true
        NbNoFormatVersion                  => true
        NbUnsupportedFormat(major, minor)  => true
        NbMissingMember(path, member)      => false
        NbWrongMemberType(path, want, saw) => false
        NbUnknownCellType(path, saw)       => false
        NbUnknownOutputType(path, saw)     => false
        NbBadCellId(path, saw)             => false
        NbDuplicateCellId(path, id)        => false
        NbForbiddenMember(path, member)    => false
        NbBadMimePayload(path, mime)       => false
        NbBadBase64(path, mime)            => false
        NbBadAttachment(path, name)        => false
        NbBadExecutionCount(path)          => false
        NbNotWritableAt(major, minor, why) => false
