// The text of a `"stream"` output whose name is `"stdout"`, joined in
// file order, or `""`.
//
// What a test harness comparing a notebook's printed output against an
// expectation reads, and the one question that would otherwise mean
// walking four output arms.
//
// ```novo
// use nbcell
//
// fn main() [io]
//     println(nbcell.stdout_text(nbcell.code_cell("a1", "print(1)")))   // (empty)
// ```
pub fn stdout_text(c: NbCell) -> Str []
    todo("ipynb-nv.nbcell.stdout_text")

// The first `"error"` output's exception name, or `None`.
//
// What tells a caller that a cell failed, which is otherwise a walk
// over the outputs.
pub fn first_error(c: NbCell) -> ?Str []
    todo("ipynb-nv.nbcell.first_error")

