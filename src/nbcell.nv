// Whether a cell identifier satisfies the nbformat 4.5 rule: between
// one and sixty-four characters, each a letter, a digit, `-` or `_`.
//
// THE ONE RULE 4.5 ADDED, and the reason it was added: a notebook's
// cells had no stable names, so a comment on a cell, a diff that
// matched cells across a save, and a tool that linked to one all had to
// use its position, which changes when a cell above it is inserted.
//
// ```novo
// use nbcell
//
// fn main() [io]
//     println("${nbcell.is_valid_cell_id("a1b2-c3_d4")}")   // true
//     println("${nbcell.is_valid_cell_id("has a space")}")  // false
// ```
pub fn is_valid_cell_id(id: Str) -> Bool []
    todo("ipynb-nv.nbcell.is_valid_cell_id")

// `c` with a different identifier.
//
// THE FUNCTION THAT KEEPS THIS PACKAGE `core`.  A fresh cell identifier
// is random, and this package may not read a random source, so a caller
// that needs one generates it — one `[rand]` call, in the host, where
// it is visible — and sets it here.  `is_valid_cell_id` is how it
// checks what it generated.
//
// ```novo
// use nbcell
//
// fn main() [io]
//     let c = nbcell.cell_id(nbcell.code_cell("", "print(1)"), "f00d")
//     println(c.id)   // f00d
// ```
pub fn cell_id(c: NbCell, id: Str) -> NbCell []
    todo("ipynb-nv.nbcell.cell_id")

// `c` with its outputs replaced.
//
// The call a tool makes after a kernel answered.  Nothing here runs the
// cell; the outputs arrive from whatever did.
pub fn with_outputs(c: NbCell, outputs: [NbOutput]) -> NbCell []
    todo("ipynb-nv.nbcell.with_outputs")

// `c` with no outputs and no execution count.
//
// What "clear all outputs" is, and what a repository that keeps
// notebooks under review runs before a commit.
//
// ```novo
// use nbcell
//
// fn main() [io]
//     let c = nbcell.cleared(nbcell.code_cell("a1", "print(1)"))
//     println("${list.len(c.outputs)}")   // 0
// ```
pub fn cleared(c: NbCell) -> NbCell []
    todo("ipynb-nv.nbcell.cleared")

