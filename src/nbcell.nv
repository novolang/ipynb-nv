// nbcell — a cell, its outputs, the MIME bundles inside them, and the
// attachments beside them.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// A MULTILINE STRING IS ONE TEXT, WRITTEN TWO WAYS.  nbformat calls a
// `source`, a `text` and a text MIME payload a "multiline string", and
// says it is either a JSON string or a JSON array of strings whose
// concatenation is that string.  Both spellings appear in real files:
// a notebook a human edited by hand has the first, a notebook Jupyter
// saved has the second.
//
// This package reads either and holds ONE `Str`.  The split is not
// information about the document — the text is the same text — and a
// type that carried it would make every consumer handle two cases to
// read one string.  The writer always emits the array-of-lines form,
// because that is what makes a notebook diff line by line in git and
// what nbformat's own writer produces.  `split_lines` is that split,
// exposed, so a caller can see exactly what will be written.
//
// AN OUTPUT IS FOUR SHAPES AND NOT ONE.  A stream carries a name and
// text; a display and an execute result carry a MIME bundle and
// metadata, and the execute result carries an execution count as well;
// an error carries a name, a value and a traceback.  They are four arms
// rather than one struct with optional members, because a display with
// an `ename` is not a document nbformat permits and a struct would have
// made it representable.
//
// A MIME BUNDLE KEEPS ITS ORDER.  A bundle is a list of entries and not
// a map, for the same reason a BSON document is: the order is in the
// file, a writer that sorted it would produce a diff nobody asked for,
// and the rules a validator applies are per entry.

// What kind of cell this is.
//
// The three `cell_type` values nbformat 4.5 defines, and no more: an
// unknown one is `NbUnknownCellType` at the reader, because a tool that
// guessed would be guessing at somebody's source code.
pub enum NbCellKind
    // `"code"` — source to be executed, with outputs and an execution
    // count.
    NbCode
    // `"markdown"` — prose, with attachments and no outputs.
    NbMarkdown
    // `"raw"` — text passed through to a converter untouched, with
    // neither outputs nor an execution count.
    NbRaw

// One entry of a MIME bundle: a MIME type and the payload under it.
//
// The payload is a JSON value because the format makes it one. A
// `text/plain` is a multiline string, an `image/png` is base64 text,
// and an `application/json` is a JSON value of any shape — which is the
// case that stops this being a `Str`.
pub struct NbMimeEntry
    // The MIME type, exactly as the file spells it: `"text/plain"`,
    // `"image/png"`, `"application/vnd.plotly.v1+json"`.
    mime: Str
    // The payload.
    payload: JsonValueH

// The alternative renderings of one output, richest first is NOT
// guaranteed — the order is the file's.
//
// A consumer picks by asking for the MIME types it can show, in its own
// order of preference, which is what `bundle_get` is for.
pub struct NbMimeBundle
    // The entries, in file order.
    entries: [NbMimeEntry]

// One thing a code cell produced.
//
// Four arms, one per `output_type` nbformat 4.5 defines.
pub enum NbOutput
    // `"stream"` — what the process wrote to `stdout` or `stderr`.
    // `name` is one of those two words.
    NbStream(name: Str, text: Str)
    // `"display_data"` — something the code asked to be displayed,
    // offered in several MIME types at once.
    NbDisplayData(data: NbMimeBundle, metadata: JsonValueH)
    // `"execute_result"` — the value of the cell's last expression,
    // offered in several MIME types at once, carrying the execution
    // count it belongs to.
    NbExecuteResult(count: Int, data: NbMimeBundle, metadata: JsonValueH)
    // `"error"` — an exception.  `traceback` is the lines as the kernel
    // formatted them, ANSI escape sequences included, because that is
    // what the file holds and stripping them is the consumer's choice.
    NbErrorOutput(ename: Str, evalue: Str, traceback: [Str])

// A file a markdown cell carries with it, under a name its source
// refers to as `attachment:<name>`.
pub struct NbAttachment
    // The name the cell's markdown refers to.
    name: Str
    // The renderings of the file.  Usually one, an `image/png`.
    data: NbMimeBundle

// One cell.
//
// ONE STRUCT FOR ALL THREE KINDS, with the members the other kinds may
// not have held as empty rather than absent.  The alternative was three
// structs, and it costs more than it saves: every consumer that walks a
// notebook would match three ways to read a `source`, and the rules
// about which member belongs to which kind are checked once, by
// `nbvalidate`, where the message can name the cell.
pub struct NbCell
    // The cell identifier nbformat 4.5 requires: one to sixty-four
    // characters of letters, digits, `-` and `_`, unique in the
    // notebook.  Empty on a notebook read at 4.4 or below, where the
    // member did not exist.
    id: Str
    // Which of the three kinds this is.
    kind: NbCellKind
    // The cell's text, with the two spellings of a multiline string
    // already collapsed into one.
    source: Str
    // The cell's own metadata: arbitrary JSON, and the place a tool
    // puts `collapsed`, `scrolled`, `tags` and its own keys.
    metadata: JsonValueH
    // What the cell produced.  Empty for a markdown or raw cell, and
    // `NbForbiddenMember` from the validator if the file had any there.
    outputs: [NbOutput]
    // The execution count of a code cell, or `None` for one that has
    // not been run.  `None` and zero are different: zero is a cell that
    // ran first, and null is a cell that never ran.
    execution_count: ?Int
    // The files a markdown cell carries.  Empty for a code or raw cell.
    attachments: [NbAttachment]

// A code cell with the given identifier and source, no outputs and no
// execution count.
//
// ```novo
// use nbcell
//
// fn main() [io]
//     let c = nbcell.code_cell("a1b2c3d4", "print(1)")
//     println(c.source)   // print(1)
// ```
pub fn code_cell(id: Str, source: Str) -> NbCell []
    todo("ipynb-nv.nbcell.code_cell")

